{
  "name": "sigfile",
  "description": "Utilities to reading signal data from files",
  "license": "Apache-2.0",
  "version": "0.1.9",
  "homepage": "https://lgsinnovations.github.io/sigfile",
  "main": "dist/sigfile.js",
  "module": "dist/sigfile.mjs",
  "exports": {
    ".": {
      "import": "./dist/sigfile.mjs",
      "require": "./dist/sigfile.js"
    },
    "./bluefile": {
      "import": "./dist/bluefile.mjs",
      "require": "./dist/bluefile.js"
    },
    "./matfile": {
      "import": "./dist/matfile.mjs",
      "require": "./dist/matfile.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "LGS Innovations, Inc.",
    "email": "sigplot@lgsinnovations.com",
    "url": "https://www.lgsinnovations.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/LGSInnovations/sigfile.git"
  },
  "bugs": {
    "url": "https://github.com/LGSInnovations/sigfile/issues"
  },
  "licenses": [
    {
      "type": "apache-2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "keywords": [
    "sigplot",
    "matlab",
    "bluefile",
    "dsp",
    "digital-signal-processing",
    "plotting",
    "parsing",
    "file-parser"
  ],
  "prettier": {
    "overrides": [
      {
        "files": [
          "*.js",
          "src/**/*.js",
          "tests/**/*.js",
          "package.json"
        ],
        "options": {
          "singleQuote": true,
          "tabWidth": 2
        }
      }
    ]
  },
  "scripts": {
    "build:prod": "npm run clean && npm run lint && npx rollup -c --environment NODE_ENV:production",
    "build:dev": "npm run clean && npm run lint && npx rollup -c",
    "clean": "rm -rf ./dist",
    "eslint": "npx eslint . --fix",
    "eslint:check": "npx eslint .",
    "generate-docs": "rm -rf ./doc/; npx jsdoc --configure .jsdoc.json --verbose",
    "lint": "npm run prettier && npm run eslint",
    "prettier": "npx prettier --ignore-path .gitignore --write \"**/*{.js,.mjs,.css,.json}\"",
    "prettier:check": "npx prettier --check --ignore-path .gitignore \"**/*{.js,.mjs,.css,.json}\"",
    "test:browser": "vitest run -c vitest.browser.config.mjs",
    "test:node": "vitest run -c vitest.node.config.mjs",
    "test": "npm run test:node && npm run test:browser",
    "test:coverage": "vitest run -c vitest.node.config.mjs --coverage && vitest run -c vitest.browser.config.mjs --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.0.0",
    "jsdoc": "^3.6.4",
    "minami": "^1.2.3",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
