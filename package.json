{
  "name": "sigfile",
  "description": "Utilities to reading signal data from files",
  "license": "Apache-2.0",
  "version": "0.1.9",
  "homepage": "https://lgsinnovations.github.io/sigfile",
  "main": "dist/sigfile.js",
  "module": "dist/sigfile.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/sigfile.mjs",
      "require": "./dist/sigfile.js"
    },
    "./bluefile": {
      "types": "./types/bluefile.d.ts",
      "import": "./dist/bluefile.mjs",
      "require": "./dist/bluefile.js"
    },
    "./matfile": {
      "types": "./types/matfile.d.ts",
      "import": "./dist/matfile.mjs",
      "require": "./dist/matfile.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "types"
  ],
  "author": {
    "name": "LGS Innovations, Inc.",
    "email": "sigplot@lgsinnovations.com",
    "url": "https://www.lgsinnovations.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/LGSInnovations/sigfile.git"
  },
  "bugs": {
    "url": "https://github.com/LGSInnovations/sigfile/issues"
  },
  "licenses": [
    {
      "type": "apache-2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "keywords": [
    "sigplot",
    "matlab",
    "bluefile",
    "dsp",
    "digital-signal-processing",
    "plotting",
    "parsing",
    "file-parser"
  ],
  "prettier": {
    "overrides": [
      {
        "files": [
          "*.js",
          "*.ts",
          "src/**/*.ts",
          "tests/**/*.ts",
          "package.json"
        ],
        "options": {
          "singleQuote": true,
          "tabWidth": 2
        }
      }
    ]
  },
  "scripts": {
    "build:prod": "npm run clean && npm run lint && NODE_ENV=production node esbuild.config.mjs && npx tsc -p tsconfig.build.json",
    "build:dev": "npm run clean && npm run lint && node esbuild.config.mjs && npx tsc -p tsconfig.build.json",
    "clean": "rm -rf ./dist ./types",
    "eslint": "npx eslint . --fix",
    "eslint:check": "npx eslint .",
    "generate-docs": "rm -rf ./doc/; npx jsdoc --configure .jsdoc.json --verbose",
    "lint": "npm run prettier && npm run eslint",
    "prettier": "npx prettier --ignore-path .gitignore --write \"**/*{.js,.mjs,.ts,.css,.json}\"",
    "prettier:check": "npx prettier --check --ignore-path .gitignore \"**/*{.js,.mjs,.ts,.css,.json}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.0.0",
    "jsdoc": "^3.6.4",
    "minami": "^1.2.3",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.0.0"
  }
}
