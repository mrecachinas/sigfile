{
  "name": "sigfile",
  "description": "Utilities to reading signal data from files",
  "license": "Apache-2.0",
  "version": "0.1.9",
  "homepage": "https://lgsinnovations.github.io/sigfile",
  "main": "dist/sigfile.js",
  "module": "dist/sigfile.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/sigfile.mjs",
      "require": "./dist/sigfile.js"
    },
    "./bluefile": {
      "types": "./types/bluefile.d.ts",
      "import": "./dist/bluefile.mjs",
      "require": "./dist/bluefile.js"
    },
    "./matfile": {
      "types": "./types/matfile.d.ts",
      "import": "./dist/matfile.mjs",
      "require": "./dist/matfile.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "types"
  ],
  "author": {
    "name": "LGS Innovations, Inc.",
    "email": "sigplot@lgsinnovations.com",
    "url": "https://www.lgsinnovations.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/LGSInnovations/sigfile.git"
  },
  "bugs": {
    "url": "https://github.com/LGSInnovations/sigfile/issues"
  },
  "licenses": [
    {
      "type": "apache-2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0"
    }
  ],
  "keywords": [
    "sigplot",
    "matlab",
    "bluefile",
    "dsp",
    "digital-signal-processing",
    "plotting",
    "parsing",
    "file-parser"
  ],
  "scripts": {
    "build:prod": "npm run clean && npm run lint && NODE_ENV=production node esbuild.config.mjs && npx tsgo -p tsconfig.build.json",
    "build:dev": "npm run clean && npm run lint && node esbuild.config.mjs && npx tsgo -p tsconfig.build.json",
    "clean": "rm -rf ./dist ./types",
    "format": "npx biome format --write .",
    "format:check": "npx biome format .",
    "generate-docs": "rm -rf ./doc/; npx jsdoc --configure .jsdoc.json --verbose",
    "lint": "npx biome check --fix .",
    "lint:check": "npx biome check .",
    "typecheck": "npx tsgo -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@typescript/native-preview": "^7.0.0-dev.20260320.1",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild": "^0.27.3",
    "jsdoc": "^3.6.4",
    "minami": "^1.2.3",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
